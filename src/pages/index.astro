---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Galeria from "../components/Galeria.astro";
import Artista from "../components/Artista.astro";
import Inspiracion from "../components/Inspiracion.astro";
import Tecnicas from "../components/Tecnicas.astro";
import Evolucion from "../components/Evolucion.astro";
import Ritual from "../components/Ritual.astro";
import Enfoque from "../components/Enfoque.astro";
import Comienzo from "../components/Comienzo.astro";
import Contacto from "../components/Contacto.astro";
import Pie from "../components/Pie.astro";
import Ficha from "../components/Ficha.astro";
import { cargarObras } from "../lib/obras";
import { cargarContenido } from "../lib/contenido";

/* Se arma en cada visita para mostrar obras y textos al día; la CDN guarda la página un minuto. */
export const prerender = false;

const [{ obras, error }, c] = await Promise.all([cargarObras(), cargarContenido()]);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=600");
const datos = JSON.stringify(
  obras.map(({ slug, titulo, tecnica, soporte, ancho_cm, alto_cm, anio, historia, precio, estado, imagen_url, imagen_ancho, imagen_alto, paleta, medidas }) => ({
    slug, titulo, tecnica, soporte, ancho_cm, alto_cm, anio, historia, precio, estado, imagen_url, imagen_ancho, imagen_alto, paleta, medidas,
  }))
).replace(/</g, "\\u003c");
const sitio = JSON.stringify({ wa: c.t("contacto.whatsapp").replace(/\D/g, "") });
const portada = obras.find((o) => o.destacada) ?? obras[0];
---
<Base
  titulo={c.t("seo.titulo")}
  descripcion={c.t("seo.descripcion")}
>
  <Fragment slot="head">
    {portada && <link rel="preload" href={portada.imagen_url} as="image" />}
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add("js");
        var vista = false;
        try { vista = sessionStorage.getItem("intro-vista") === "1"; } catch (e) {}
        var reducir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (/[?&]intro\b/.test(location.search)) vista = false;
        if (location.hash.indexOf("#obra/") === 0) vista = true;
        if (!vista && !reducir) h.classList.add("con-intro");
      })();
    </script>
  </Fragment>
  <Intro />
  <Nav c={c} />
  <main>
    <Hero obras={obras} c={c} />
    <Galeria obras={obras} error={error} c={c} />
    <Artista c={c} />
    <Inspiracion c={c} />
    <Tecnicas c={c} />
    <Evolucion c={c} />
    <Ritual c={c} />
    <Enfoque c={c} />
    <Comienzo c={c} />
    <Contacto c={c} />
  </main>
  <Pie c={c} />
  <Ficha />
  <script type="application/json" id="datos-obras" set:html={datos}></script>
  <script type="application/json" id="datos-sitio" set:html={sitio}></script>
  <script>
    import "../scripts/sitio.js";
  </script>
</Base>
