---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const foto = c.img("enfoque.foto");
const colores = ["var(--rosa)", "var(--limon)", "var(--cielo)"];
---
<section class="enfoque" id="enfoque">
      <figure class="enfoque__foto">
        <img src={foto.src} width={foto.ancho} height={foto.alto} loading="lazy" alt={foto.alt}>
      </figure>
      <div class="enfoque__lista">
        <h2 class="titulo" data-rev>{c.t("enfoque.titulo")}</h2>
        <p class="enfoque__intro" data-rev>{c.t("enfoque.intro")}</p>
        {colores.map((color, i) => (
          <article data-rev style={"--c:" + color}>
            <h3>{c.t(`enfoque.${i + 1}.titulo`)}</h3>
            <p>{c.t(`enfoque.${i + 1}.texto`)}</p>
          </article>
        ))}
      </div>
    </section>
