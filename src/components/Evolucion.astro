---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const foto = c.img("evolucion.foto");
---
<section class="evolucion" id="evolucion">
      <div class="evolucion__texto">
        <h2 class="titulo" data-rev>{c.t("evolucion.titulo")}</h2>
        {c.parrafos("evolucion.texto").map((p) => <p data-rev>{p}</p>)}
      </div>
      <figure class="evolucion__foto" data-rev>
        <img src={foto.src} width={foto.ancho} height={foto.alto} loading="lazy" alt={foto.alt}>
      </figure>
    </section>
