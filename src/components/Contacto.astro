---
import Icono from "./Icono.astro";
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const wa = c.wa(c.t("mensajes.saludo"));
const correo = c.t("contacto.correo");
const ig = c.t("contacto.instagram").replace(/^@/, "");
const foto = c.img("contacto.foto");
---
<section class="contacto" id="contacto">
      <div class="contacto__texto">
        <img class="contacto__sol" src="/assets/marca/sol-firma.webp" width="683" height="791" loading="lazy" alt="Logo de Sam Velásquez">
        <h2 class="titulo titulo--gran" data-rev>{c.t("contacto.titulo")}</h2>
        <p data-rev>{c.t("contacto.texto")}</p>
        <a class="boton boton--oro boton--grande" href={wa} target="_blank" rel="noopener" data-rev><Icono n="whatsapp" />{c.t("contacto.boton")}</a>
        <ul class="contacto__datos" data-rev>
          <li><a href={wa} target="_blank" rel="noopener"><Icono n="whatsapp" />{c.t("contacto.whatsapp_visible")}</a></li>
          {correo && <li><a href={"mailto:" + correo}><Icono n="correo" />{correo}</a></li>}
          {ig && <li><a href={"https://www.instagram.com/" + encodeURIComponent(ig) + "/"} target="_blank" rel="noopener"><Icono n="instagram" />{ig}</a></li>}
        </ul>
      </div>
      <figure class="contacto__foto">
        <img src={foto.src} width={foto.ancho} height={foto.alto} loading="lazy" alt={foto.alt}>
      </figure>
    </section>
