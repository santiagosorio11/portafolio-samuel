---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const posiciones = [
  "--x:2%;--y:6%;--w:25%;--r:-7deg;--dx:-90px;--dy:60px",
  "--x:24%;--y:30%;--w:23%;--r:5deg;--dx:-30px;--dy:120px",
  "--x:45%;--y:2%;--w:24%;--r:-3deg;--dx:0px;--dy:-90px",
  "--x:61%;--y:38%;--w:21%;--r:8deg;--dx:60px;--dy:110px",
  "--x:77%;--y:5%;--w:22%;--r:4deg;--dx:110px;--dy:-30px",
];
const fotos = posiciones.map((estilo, i) => ({ estilo, ...c.img("comienzo.foto" + (i + 1)) }));
---
<section class="comienzo" id="comienzo">
      <canvas class="trazos" data-trazos="comienzo" aria-hidden="true"></canvas>
      <div class="comienzo__texto">
        <h2 class="titulo" data-rev>{c.t("comienzo.titulo")}</h2>
        <p data-rev>{c.t("comienzo.texto")}</p>
      </div>
      <div class="polaroids" id="polaroids">
        {fotos.map((f) => <figure style={f.estilo}><img src={f.src} width={f.ancho} height={f.alto} loading="lazy" alt={f.alt}></figure>)}
      </div>
    </section>
