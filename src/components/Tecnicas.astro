---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const colores = ["var(--rosa)", "var(--durazno)", "var(--cielo)", "var(--limon)"];
const tiras = colores.map((color, i) => ({
  color,
  titulo: c.t(`tecnicas.${i + 1}.titulo`),
  texto: c.t(`tecnicas.${i + 1}.texto`),
  img: c.img(`tecnicas.${i + 1}.imagen`),
}));
---
<section class="tecnicas" id="tecnicas">
      <h2 class="titulo" data-rev>{c.t("tecnicas.titulo")}</h2>
      <div class="tiras" id="tiras">
        {tiras.map((t, i) => (
          <article class={"tira" + (i === 0 ? " activa" : "")} tabindex="0" style={"--c:" + t.color}>
            <img src={t.img.src} width={t.img.ancho} height={t.img.alto} loading="lazy" alt={t.img.alt}>
            <div class="tira__texto">
              <h3>{t.titulo}</h3>
              <p>{t.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
