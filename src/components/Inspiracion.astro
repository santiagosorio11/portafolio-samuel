---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
/* Las palabras entre *asteriscos* se resaltan, alternando estos colores. */
const colores = ["var(--menta)", "var(--durazno)", "var(--lila)", "var(--rosa)", "var(--cielo)"];
const partes = c.t("inspiracion.texto").split(/\*([^*]+)\*/);
---
<section class="inspiracion" id="inspiracion">
      <p class="inspiracion__gran" data-rev>
        {partes.map((p, i) => (i % 2 ? <mark style={"--c:" + colores[((i - 1) / 2) % colores.length]}>{p}</mark> : p))}
      </p>
      <p class="inspiracion__sub" data-rev>{c.t("inspiracion.sub")}</p>
    </section>
