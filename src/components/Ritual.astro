---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const fotos = [1, 2, 3].map((n) => c.img("ritual.foto" + n));
const practicas = c.lineas("ritual.practicas");
---
<section class="ritual" id="ritual">
      <div class="ritual__fotos" aria-hidden="true">
        {fotos.map((f) => <img src={f.src} width={f.ancho} height={f.alto} loading="lazy" alt="">)}
      </div>
      <div class="ritual__panel" data-rev>
        <h2 class="titulo">{c.t("ritual.titulo")}</h2>
        <p>{c.t("ritual.texto")}</p>
      </div>
      {practicas.length > 0 && (
        <div class="cinta" aria-label={"Prácticas del ritual: " + practicas.join(", ")}>
          <div class="cinta__pista" aria-hidden="true">
            {[...practicas, ...practicas].map((p) => <span>{p}</span>)}
          </div>
        </div>
      )}
    </section>
