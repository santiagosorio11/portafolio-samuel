---
import Lienzo from "./Lienzo.astro";
import type { Obra } from "../lib/obras";
interface Props { obras: Obra[] }
const { obras } = Astro.props;
/* Portada: las obras marcadas como destacadas; si no hay, las dos primeras del muro. */
const elegidas = [...obras.filter((o) => o.destacada), ...obras.filter((o) => !o.destacada)].slice(0, 2);
const [grande, chica] = elegidas;
const chicaHorizontal = chica && chica.imagen_ancho > chica.imagen_alto * 1.3;
---
<section class="hero" id="inicio">
  <div class="hero__resplandor" aria-hidden="true"></div>
  <canvas class="hero__trazos" id="hero-trazos" aria-hidden="true"></canvas>
  <canvas class="hero__dedo" id="hero-dedo" aria-hidden="true"></canvas>
  <div class="hero__texto">
    <p class="hero__concepto">Revolución solar</p>
    <h1 class="hero__nombre">
      <span class="linea"><span>Sam</span></span>
      <span class="linea"><span class="hero__apellido">Velásquez</span></span>
    </h1>
    <p class="hero__lema">Obras que nacen del alma y se convierten en intención.</p>
    <div class="hero__acciones">
      <a class="trazo-boton" href="#galeria">
        <svg class="trazo-boton__pintura" viewBox="0 0 320 84" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="trazo-boton-color" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#f7801f" />
              <stop offset=".55" stop-color="#e2531a" />
              <stop offset="1" stop-color="#b8380f" />
            </linearGradient>
          </defs>
          <path fill="url(#trazo-boton-color)" d="M10 40c4-14 26-22 58-24 40-3 78 2 116-2 34-4 70-8 104-2 18 3 28 12 26 24-2 13-14 22-36 26-30 5-66 2-100 6-34 4-70 6-104 4-30-2-54-6-62-16-4-5-4-10-2-16z" />
          <path fill="none" stroke="#ffb547" stroke-width="2.4" stroke-linecap="round" opacity=".75" d="M30 30c60-6 140-4 250-8M40 58c70 2 150-4 236-2" />
          <path fill="none" stroke="#8f2a0b" stroke-width="1.6" stroke-linecap="round" opacity=".45" d="M24 46c80-5 170 0 266-6M300 30c6 4 10 12 2 22" />
          <path fill="#c2410c" opacity=".85" d="M300 38c8-2 16 2 16 8s-8 10-14 8c4-4 4-10-2-16z" />
        </svg>
        <span class="trazo-boton__texto">Ver la galería<span class="trazo-boton__flecha" aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
  <div class="hero__arte">
    <img class="hero__sol" src="/assets/marca/sol.webp" width="1004" height="1218" alt="" />
    {grande && <div class="hero__obra hero__obra--grande"><Lienzo obra={grande} prioridad /></div>}
    {chica && <div class={"hero__obra hero__obra--chica" + (chicaHorizontal ? " hero__obra--apaisada" : "")}><Lienzo obra={chica} prioridad /></div>}
  </div>
</section>
