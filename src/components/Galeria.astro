---
import Lienzo from "./Lienzo.astro";
import { enlaceWa, MENSAJES } from "../lib/contacto";
import { mosaico } from "../lib/mosaico";
import type { Obra } from "../lib/obras";
interface Props { obras: Obra[]; error: boolean }
const { obras, error } = Astro.props;
const { escritorio, movil } = mosaico(obras);
---
<section class="galeria" id="galeria">
  <div class="galeria__cabeza">
    <h2 class="titulo">La galería</h2>
    {obras.length > 0 && <p>Abre cualquier lienzo para conocer su historia.</p>}
  </div>
  {obras.length > 0 ? (
    <div class="pared" id="pared" style={`--alto:${escritorio.alto};--alto-m:${movil.alto}`}>
      {obras.map((obra, i) => {
        const d = escritorio.posiciones[i];
        const m = movil.posiciones[i];
        return (
          <article
            class={"obra" + (obra.soporte === "escultura" ? " obra--escultura" : "")}
            style={`--x:${d.x};--y:${d.y};--w:${d.w};--mx:${m.x};--my:${m.y};--mw:${m.w};--d:${(i % 4) * 90}ms`}
          >
            <Lienzo obra={obra} />
            <div class="cartela">
              <h3>{obra.titulo}</h3>
              <p>
                {obra.medidas}{obra.anio ? ", " + obra.anio : ""}
                {obra.vendida && <><br />Colección privada</>}
              </p>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="pared__vacia">{error ? "La galería se está actualizando. Vuelve en unos minutos." : "Muy pronto habrá nuevas obras en este muro."}</p>
  )}
  <div class="pared__frase" data-rev>
    <p>“Más que observar,<br />te invito a sentir.”</p>
    <a class="boton boton--linea" href={enlaceWa(MENSAJES.encargo)} target="_blank" rel="noopener">Encargar una obra</a>
  </div>
</section>
