---
import Lienzo from "./Lienzo.astro";
import { mosaico } from "../lib/mosaico";
import { ESTADOS, type Obra } from "../lib/obras";
import type { Contenido } from "../lib/contenido";
interface Props { obras: Obra[]; error: boolean; c: Contenido }
const { obras, error, c } = Astro.props;
const frase = c.lineas("galeria.frase");
const { escritorio, movil } = mosaico(obras);
---
<section class="galeria" id="galeria">
  <div class="galeria__cabeza">
    <h2 class="titulo">{c.t("galeria.titulo")}</h2>
    {obras.length > 0 && <p>{c.t("galeria.ayuda")}</p>}
  </div>
  {obras.length > 0 ? (
    <div class="pared" id="pared" style={`--alto:${escritorio.alto};--alto-m:${movil.alto}`}>
      {obras.map((obra, i) => {
        const d = escritorio.posiciones[i];
        const m = movil.posiciones[i];
        return (
          <article
            class={"obra" + (obra.soporte === "escultura" ? " obra--escultura" : "")}
            style={`--x:${d.x};--y:${d.y};--w:${d.w};--mx:${m.x};--my:${m.y};--mw:${m.w};--d:${(i % 4) * 90}ms`}
          >
            <Lienzo obra={obra} />
            <div class="cartela">
              <h3>{obra.titulo}</h3>
              <p>
                {obra.medidas}{obra.anio ? ", " + obra.anio : ""}
                {ESTADOS[obra.estado].cartela && <><br />{ESTADOS[obra.estado].cartela}</>}
              </p>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="pared__vacia">{error ? "La galería se está actualizando. Vuelve en unos minutos." : c.t("galeria.vacia")}</p>
  )}
  <div class="pared__frase" data-rev>
    <p>{frase.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
    <a class="boton boton--linea" href={c.wa(c.t("mensajes.encargo"))} target="_blank" rel="noopener">{c.t("galeria.boton")}</a>
  </div>
</section>
