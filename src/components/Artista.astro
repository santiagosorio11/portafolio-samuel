---
import type { Contenido } from "../lib/contenido";
interface Props { c: Contenido }
const { c } = Astro.props;
const foto = c.img("artista.foto");
const foto2 = c.img("artista.foto2");
---
<section class="artista" id="artista">
      <canvas class="trazos" data-trazos="artista" aria-hidden="true"></canvas>
      <figure class="artista__foto" data-rev>
        <img src={foto.src} width={foto.ancho} height={foto.alto} loading="lazy" alt={foto.alt}>
      </figure>
      <div class="artista__texto">
        <h2 class="titulo" data-rev>{c.t("artista.titulo")}</h2>
        {c.parrafos("artista.texto").map((p) => <p data-rev>{p}</p>)}
        <figure class="artista__mano" data-rev>
          <img src={foto2.src} width={foto2.ancho} height={foto2.alto} loading="lazy" alt={foto2.alt}>
        </figure>
      </div>
    </section>
