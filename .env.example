# Proyecto de Supabase (Settings > API Keys > Publishable key). Estas dos van también en Vercel.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para "npm run sembrar" en tu computador. Nunca la subas a Vercel ni a git.
# Llave secreta (Settings > API Keys > Secret keys, empieza por sb_secret_).
# Si usas las llaves antiguas, puedes poner la service_role en SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
